                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{recruiterToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"problem\": {\n    \"title\": \"What does HTTP 409 mean?\",\n    \"type\": \"MCQ\",\n    \"difficulty\": \"EASY\",\n    \"prompt\": \"What does HTTP status code 409 indicate?\",\n    \"options\": [\"Conflict\", \"OK\", \"Not Found\", \"Unauthorized\"],\n    \"correctAnswer\": \"Conflict\",\n    \"points\": 2,\n    \"tags\": [\"http\", \"status\"]\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/problems",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "problems"
              ]
