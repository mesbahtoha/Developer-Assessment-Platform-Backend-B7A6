            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Name\",\n  \"avatarUrl\": \"https://example.com/avatar.jpg\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            }
          }
        },
        {
          "name": "Admin: List Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "query": [
              {
                "key": "page",
                "value": "1",
                "description": "Page number"
              },
              {
                "key": "limit",
                "value": "10",
                "description": "Items per page"
              },
              {
                "key": "role",
                "description": "Filter by role (CANDIDATE/RECRUITER/ADMIN)",
                "value": ""
              },
              {
                "key": "isDeleted",
                "description": "Filter by deletion status (true/false)",
                "value": ""
              },
              {
                "key": "search",
                "description": "Search by name or email"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users"
              ]
            }
          }
        },
        {
          "name": "Admin: Search Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "query": [
              {
                "key": "q",
                "description": "Search query (name/email)",
                "value": "john"
              },
              {
                "key": "limit",
                "value": "10",
                "description": "Max results to return"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users",
                "search"
              ]
            }
          }
        },
        {
          "name": "Admin: Update User Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"true\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/users/:id/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users",
                ":id",
                "status"
              ]
            }
          }
        },
        {
          "name": "Admin: Update User Role",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"RECRUITER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/users/:id/role",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users",
                ":id",
                "role"
              ]
            }
          }
        },
        {
          "name": "Admin: Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/dashboard-stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "dashboard-stats"
              ]
            }
          }
        }
