              },
              {
                "key": "type",
                "description": "Filter by MCQ/CODE",
                "value": ""
              },
              {
                "key": "difficulty",
                "description": "Filter by EASY/MEDIUM/HARD",
                "value": ""
              },
              {
                "key": "search",
                "description": "Search by title or prompt"
              },
              {
                "key": "sortBy",
                "value": "createdAt",
                "description": "Sort field"
              },
              {
                "key": "sortOrder",
                "value": "desc",
                "description": "Sort order"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/problems",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "problems"
              ]
            }
          }
        },
        {
          "name": "Search Problems",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
