# ===== Server =====
NODE_ENV=development
PORT=5000

# ===== Database (PostgreSQL / Prisma Postgres) =====
# Example: postgresql://postgres:mysecretpassword@localhost:5432/assessment_platform?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# ===== JWT (Bearer access token + rotating refresh token) =====
JWT_ACCESS_SECRET=replace_with_long_random_string_access
JWT_REFRESH_SECRET=replace_with_long_random_string_refresh
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ===== CORS (comma separated list of allowed origins) =====
CLIENT_URL=http://localhost:3000

# ===== Google social login (Google Identity Services ID token) =====
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ===== Stripe payments (real payment processing + signed webhooks) =====
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ===== Redis cache (optional: the API degrades gracefully without it) =====
# Cached namespaces: assessment/problem listings, assessment reports, admin dashboard stats
# Also backs the rate-limit counters so the quota is shared across serverless instances.
REDIS_URL=

# ===== Rate limiting (express-rate-limit; Redis-backed store) =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ===== Seed credentials (npm run seed) =====
ADMIN_EMAIL=admin@assessment.com
ADMIN_PASSWORD=Admin@1234
